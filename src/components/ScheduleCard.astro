---
interface Props {
  date: Date;
  title: string;
  site: string;
  content: string;
  images?: string[];
  slug?: string;
  labels?: string[];
}

const { date, title, site, content, images, slug, labels } = Astro.props;

// ラベルの色を決定する関数
const getLabelClass = (label: string) => {
  if (label === 'マミソロ') return 'label-red';
  if (label === 'あおはるソロ') return 'label-blue';
  return '';
};

// メンバーカラーをカード枠のアクセントに反映
const accentClass = labels?.includes('マミソロ')
  ? 'accent-red'
  : labels?.includes('あおはるソロ')
    ? 'accent-blue'
    : '';

// 日付フォーマット（表示は常に日本時間）
const formatDate = (d: Date) => {
  const parts = new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    weekday: 'short'
  }).formatToParts(d);

  const pick = (type: string) => parts.find(p => p.type === type)?.value || '';
  return {
    year: Number(pick('year')),
    month: pick('month'),
    day: pick('day'),
    weekday: pick('weekday')
  };
};

const dateInfo = formatDate(date);

// TBD（詳細未定）の扱い: 内部用語をそのまま出さず「詳細は後日発表」に変換。
// 「TBD + 詳細リンク」の形式はリンク部分だけ残す。
const trimmedContent = (content ?? '').trim();
const isTBD = trimmedContent === 'TBD' || trimmedContent.startsWith('TBD\n');
const displayContent = isTBD ? trimmedContent.replace(/^TBD\s*/, '') : trimmedContent;

// 長文はカード内で折りたたむ（全文は詳細ページで読める）
const isLongContent = displayContent.split('\n').length > 12;

const Wrapper = slug ? 'a' : 'div';
---

<Wrapper href={slug ? `/events/${slug}` : undefined} class="schedule-card-link">
  <article class={`schedule-card ${accentClass}`}>
    <div
      class={`card-header ${images && images.length > 0 ? 'has-image' : 'stripe-pattern'}`}
      style={images && images.length > 0 ? `background-image: url('${images[0]}')` : ''}
    >
      <div class="header-top">
        <div class="date-badge">
          <span class="date-year">{dateInfo.year}</span>
          <span class="date-main">{dateInfo.month}/{dateInfo.day}</span>
          <span class="date-weekday">({dateInfo.weekday})</span>
        </div>
        {labels && labels.length > 0 && (
          <div class="labels-container">
            {labels.map((label) => (
              <span class={`label-tag ${getLabelClass(label)}`}>{label}</span>
            ))}
          </div>
        )}
      </div>
      <h3 class="card-title">{title}</h3>
    </div>

    <div class="card-body">
      <div class="venue-info">
        <i class="venue-icon fa-solid fa-location-dot" aria-hidden="true"></i>
        <span class="venue-name">{site}</span>
      </div>

      {isTBD && (
        <div class="tbd-notice">
          <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
          <span>詳細は後日発表</span>
        </div>
      )}

      {displayContent && (
        <div class={`event-details ${isLongContent ? 'clamped' : ''}`}>{displayContent}</div>
      )}

      {isLongContent && slug && (
        <div class="read-more">続きは詳細ページで <i class="fa-solid fa-angles-right" aria-hidden="true"></i></div>
      )}
    </div>
  </article>
</Wrapper>

<style>
  .schedule-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .schedule-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-medium) 0%, var(--bg-dark) 100%);
    border: 2px solid var(--retro-pink);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.3),
      0 0 20px rgba(255, 110, 199, 0.3),
      inset 0 0 30px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  /* メンバーカラーのアクセント（マミ=赤 / あおはる=青） */
  .schedule-card.accent-red {
    border-color: #ff5252;
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.3),
      0 0 20px rgba(255, 23, 68, 0.35),
      inset 0 0 30px rgba(0, 0, 0, 0.3);
  }

  .schedule-card.accent-blue {
    border-color: #448aff;
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.3),
      0 0 20px rgba(41, 121, 255, 0.35),
      inset 0 0 30px rgba(0, 0, 0, 0.3);
  }

  .schedule-card-link:hover .schedule-card,
  .schedule-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 8px 0 rgba(0, 0, 0, 0.3),
      0 0 30px rgba(255, 110, 199, 0.6),
      0 0 40px rgba(0, 255, 255, 0.3),
      inset 0 0 30px rgba(0, 0, 0, 0.3);
    border-color: var(--retro-cyan);
  }

  .card-header {
    background: linear-gradient(135deg, var(--retro-cyan) 0%, var(--retro-purple) 100%);
    padding: 20px;
    position: relative;
  }

  .stripe-pattern {
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255, 255, 255, 0.1) 10px,
      rgba(255, 255, 255, 0.1) 20px
    );
  }

  .card-header.has-image {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* タイトルの可読性を確保するグラデーションスクリム
     （上下を濃く・中央は薄くしてフライヤーを見せる） */
  .card-header.has-image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.15) 40%,
      rgba(0, 0, 0, 0.2) 60%,
      rgba(0, 0, 0, 0.8) 100%
    );
    z-index: 0;
  }

  .card-header.has-image .header-top,
  .card-header.has-image .card-title {
    position: relative;
    z-index: 1;
  }

  .header-top {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .date-badge {
    display: inline-flex;
    align-items: center;
    background: var(--retro-yellow);
    color: var(--bg-dark);
    padding: 8px 16px;
    border-radius: 20px;
    font-family: var(--font-digital);
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow:
      0 3px 0 rgba(0, 0, 0, 0.3),
      0 0 10px rgba(255, 214, 10, 0.5);
    letter-spacing: 1px;
  }

  .date-year {
    margin-right: 8px;
    opacity: 0.7;
  }

  .date-main {
    font-size: 1.1rem;
    margin-right: 6px;
  }

  .date-weekday {
    opacity: 0.8;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: white;
    margin: 0;
    text-shadow:
      0 1px 3px rgba(0, 0, 0, 0.9),
      0 0 12px rgba(0, 0, 0, 0.8);
    line-height: 1.4;
  }

  .card-body {
    padding: 20px;
  }

  .venue-info {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: rgba(255, 110, 199, 0.1);
    border-left: 4px solid var(--retro-pink);
    border-radius: 4px;
    margin-bottom: 16px;
  }

  .venue-icon {
    font-size: 1.1rem;
    color: var(--retro-pink);
  }

  .venue-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--pastel-pink);
  }

  .labels-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .label-tag {
    display: inline-block;
    padding: 4px 12px;
    background: linear-gradient(135deg, var(--retro-purple) 0%, var(--retro-pink) 100%);
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 12px;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.3), 0 0 10px rgba(255, 110, 199, 0.3);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.3);
  }

  .label-tag.label-red {
    background: linear-gradient(135deg, #ff1744 0%, #ff5252 100%);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.3), 0 0 10px rgba(255, 23, 68, 0.5);
  }

  .label-tag.label-blue {
    background: linear-gradient(135deg, #2979ff 0%, #448aff 100%);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.3), 0 0 10px rgba(41, 121, 255, 0.5);
  }

  .tbd-notice {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    margin-bottom: 12px;
    background: rgba(255, 214, 10, 0.08);
    border: 1px dashed rgba(255, 214, 10, 0.5);
    border-radius: 4px;
    color: var(--retro-yellow);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .event-details {
    font-family: var(--font-base);
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-light);
    margin: 0;
    padding: 12px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    border: 1px solid rgba(255, 110, 199, 0.2);
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  /* 長文はカード内で折りたたみ、下端をフェードアウト */
  .event-details.clamped {
    max-height: 18em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
  }

  .read-more {
    margin-top: 8px;
    text-align: right;
    font-size: 0.85rem;
    color: var(--retro-cyan);
  }

  /* レスポンシブ対応 */
  @media (max-width: 768px) {
    .card-header {
      padding: 16px;
    }

    .date-badge {
      font-size: 0.85rem;
      padding: 6px 14px;
    }

    .date-main {
      font-size: 1rem;
    }

    .card-title {
      font-size: 1.1rem;
    }

    .card-body {
      padding: 16px;
    }

    .venue-info {
      padding: 10px 14px;
    }

    .venue-name {
      font-size: 0.95rem;
    }

    .event-details {
      font-size: 0.85rem;
      padding: 10px;
    }
  }

  @media (max-width: 480px) {
    .card-header {
      padding: 14px;
    }

    .date-badge {
      font-size: 0.8rem;
      padding: 5px 12px;
    }

    .date-year {
      display: block;
      margin-bottom: 2px;
    }

    .card-title {
      font-size: 1rem;
    }

    .card-body {
      padding: 14px;
    }

    .venue-info {
      padding: 8px 12px;
    }

    .venue-name {
      font-size: 0.9rem;
    }

    .event-details {
      font-size: 0.8rem;
      padding: 8px;
    }
  }

  /* アニメーション無効化（アクセシビリティ） */
  @media (prefers-reduced-motion: reduce) {
    .schedule-card {
      transition: none !important;
    }

    .schedule-card:hover {
      transform: none;
    }
  }
</style>
