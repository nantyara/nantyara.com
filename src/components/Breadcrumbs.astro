---
import { stringifyStructuredData } from '../utils/structured-data';

interface Item {
  label: string;
  href?: string;
}

const { items } = Astro.props as { items: Item[] };
const site = Astro.site ?? new URL('https://nantyara.com');
const jsonLd = stringifyStructuredData({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, site).href } : {}),
  })),
});
---

<nav class="breadcrumbs" aria-label="パンくず">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <span class="separator" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={jsonLd}></script>

<style>
  .breadcrumbs {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
    font-size: 0.85rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  a { color: var(--retro-cyan); }
  span[aria-current='page'] { color: var(--text-light); opacity: 0.8; }
  .separator { color: var(--pastel-lavender); }
</style>
