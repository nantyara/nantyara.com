---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import { navItems, snsLinks } from '../data/nav';
import '../styles/main.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title = 'なんちゃらアイドル',
  description = 'なんちゃらアイドル公式サイト - スケジュール・ライブ情報',
  ogImage = '/img/ogp-default.png',
  ogType = 'website',
} = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
const site = Astro.site ?? new URL('https://nantyara.com');
const canonicalURL = new URL(currentPath, site);
const ogImageURL = new URL(ogImage, site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0A0A0A">
    <meta name="description" content={description}>

    <!-- OGP -->
    <link rel="canonical" href={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:site_name" content="なんちゃらアイドル">
    <meta property="og:locale" content="ja_JP">
    <meta property="og:image" content={ogImageURL}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageURL}>

    <!-- PWA対応 -->
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="なんちゃら">

    <title>{title}</title>
    <slot name="head" />

    <!-- Favicon & Icons -->
    <link rel="icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/pwa-icons/apple-touch-icon.png">

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.webmanifest">
    <Font cssVariable="--font-yusei" />
    <Font cssVariable="--font-rampart" />
    <Font cssVariable="--font-rocknroll" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script is:inline>
      try {
        var pos = localStorage.getItem('menu-button-position');
        if (pos === 'left') document.documentElement.setAttribute('data-menu-position', 'left');
      } catch(e) {}
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // 新バージョン検知時にトーストを出す
          // （autoUpdate なので SW 自体は勝手に切り替わる。画面の反映にはリロードが必要）
          var showUpdateToast = function() {
            if (document.querySelector('.update-toast')) return;
            var toast = document.createElement('div');
            toast.className = 'update-toast';
            toast.innerHTML = '<span>新しい情報があります</span>';
            var btn = document.createElement('button');
            btn.className = 'update-toast-btn';
            btn.textContent = '更新';
            btn.addEventListener('click', function() { location.reload(); });
            toast.appendChild(btn);
            document.body.appendChild(toast);
          };

          navigator.serviceWorker.register('/sw.js', { scope: '/' })
            .then(reg => {
              reg.addEventListener('updatefound', function() {
                var nw = reg.installing;
                if (!nw) return;
                nw.addEventListener('statechange', function() {
                  if (nw.state === 'activated' && navigator.serviceWorker.controller) {
                    showUpdateToast();
                  }
                });
              });
            })
            .catch(err => console.log('SW registration failed:', err));
        });
      }
    </script>
  </head>
  <body class="scanlines vhs-distortion">
    <div id="pull-to-refresh" class="ptr">
      <div class="ptr-indicator">
        <span class="ptr-spinner"></span>
        <span class="ptr-text"></span>
      </div>
    </div>
    <HamburgerMenu currentPath={currentPath} />
    <Header currentPath={currentPath} />
    <div class="site-container">
      <main class="main">
        <slot />
      </main>
    </div>
    <footer class="footer">
      <nav class="footer-nav" aria-label="フッターナビゲーション">
        {navItems.map(item => (
          <a href={item.href} class="footer-nav-link">{item.label}</a>
        ))}
      </nav>
      <div class="footer-sns">
        {snsLinks.map(sns => (
          <a href={sns.href} target="_blank" rel="noopener noreferrer" class="footer-sns-link" aria-label={sns.label}>
            <i class={sns.icon} aria-hidden="true"></i>
          </a>
        ))}
      </div>
      <p>&copy; 2018-2026 なんちゃらアイドル</p>
    </footer>
    <script is:inline>
      // ファーストビューを過ぎたら装飾アニメを一時停止（省エネ）
      (function() {
        var tick = false;
        window.addEventListener('scroll', function() {
          if (tick) return;
          tick = true;
          requestAnimationFrame(function() {
            document.body.classList.toggle('anim-paused', window.scrollY > window.innerHeight);
            tick = false;
          });
        }, { passive: true });
      })();
    </script>
    <script is:inline>
      (function() {
        var ptr = document.getElementById('pull-to-refresh');
        if (!ptr) return;

        var startY = 0;
        var pulling = false;
        var threshold = 60;

        document.addEventListener('touchstart', function(e) {
          if (window.scrollY !== 0) return;
          if (document.body.style.overflow === 'hidden') return;
          startY = e.touches[0].clientY;
          pulling = true;
          ptr.classList.remove('ready', 'refreshing');
          ptr.classList.add('pulling');
        }, { passive: true });

        document.addEventListener('touchmove', function(e) {
          if (!pulling) return;
          if (document.body.style.overflow === 'hidden') {
            pulling = false;
            ptr.style.height = '';
            ptr.classList.remove('pulling', 'ready');
            return;
          }

          var dy = e.touches[0].clientY - startY;
          if (dy < 0) {
            ptr.style.height = '';
            ptr.classList.remove('pulling', 'ready');
            return;
          }

          // 抵抗感のある引っ張り（対数的に減衰）
          var dist = Math.min(dy * 0.4, 120);
          ptr.style.height = dist + 'px';

          if (dist >= threshold) {
            ptr.classList.add('ready');
          } else {
            ptr.classList.remove('ready');
          }

          if (window.scrollY === 0 && dy > 0) {
            e.preventDefault();
          }
        }, { passive: false });

        document.addEventListener('touchend', function() {
          if (!pulling) return;
          pulling = false;

          if (ptr.classList.contains('ready')) {
            ptr.classList.remove('pulling', 'ready');
            ptr.classList.add('refreshing');
            ptr.style.height = '';
            location.reload();
          } else {
            ptr.style.height = '';
            ptr.classList.remove('pulling', 'ready');
          }
        }, { passive: true });
      })();
    </script>
  </body>
</html>
