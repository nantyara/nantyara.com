---
import Layout from '../layouts/Layout.astro';
import ScheduleCard from '../components/ScheduleCard.astro';
import { loadAllSchedules } from '../utils/schedules';
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import { snsLinks } from '../data/nav';
import { buildMusicGroup, buildWebSite, stringifyStructuredData } from '../utils/structured-data';

// YAMLファイル読み込み（全ての schedules/*.yml を統合）
const allSchedules = loadAllSchedules();

// 昇順（古→新）の全イベント
const schedules = [...allSchedules].sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
);

// 12時間ルール: 現在時刻 - 12時間を基準に「今後」を判定（クライアント側でも再計算する）
const expireTime = Date.now() - 12 * 60 * 60 * 1000;

// NEXT LIVE（直近の今後イベント）
const nextLive = schedules.find(s => new Date(s.date).getTime() >= expireTime) ?? null;
const members = parse(readFileSync('src/data/members.yml', 'utf-8')) as Array<{ name: string }>;
const musicGroupJsonLd = stringifyStructuredData(buildMusicGroup(
  snsLinks.map((link) => link.href),
  members.map((member) => member.name),
));
const webSiteJsonLd = stringifyStructuredData(buildWebSite());

// パフォーマンス方針（2026-07-07）: 「今後の予定」は件数が少なく増え続けないので
// 従来どおりサーバーで全件HTML描画する（初回表示が速く、JS無効でも見える・SEOにも強い）。
// 一方「過去の予定」はXアーカイブ発掘で今後も増え続け、全件HTMLで送ると肥大化する一方なので、
// 軽量JSONだけをページに埋め込み、実際のカード描画とページング（無限スクロール）はクライアント側で行う。
// これによりネットワーク転送量・DOM要素数のどちらも「今後の予定」の件数だけに比例するようになり、
// 過去イベントが何千件に増えてもトップページの初回表示コストは増えない。
const upcomingSchedules = schedules.filter(s => new Date(s.date).getTime() >= expireTime);

// 月ごとにグルーピング（JST基準・「今後の予定」のみ。過去分はクライアント側で同様にグルーピングする）
const monthPartsFmt = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
});

const monthGroups: { key: string; label: string; items: typeof schedules }[] = [];
for (const schedule of upcomingSchedules) {
  const parts = monthPartsFmt.formatToParts(new Date(schedule.date));
  const year = parts.find(p => p.type === 'year')?.value ?? '';
  const month = parts.find(p => p.type === 'month')?.value ?? '';
  const key = `${year}-${month}`;
  let group = monthGroups.find(g => g.key === key);
  if (!group) {
    group = { key, label: `${year}年${Number(month)}月`, items: [] };
    monthGroups.push(group);
  }
  group.items.push(schedule);
}

// クライアント側の「過去/すべて」描画・検索用の軽量データは、ページに埋め込まず
// /events.json（src/pages/events.json.ts で静的生成）としてビルドし、
// ユーザーが実際に「過去」「すべて」を選んだ瞬間だけクライアントが fetch する（lazy load）。
// これにより「今後の予定」だけを見に来た大多数の訪問では、過去イベント分のデータを
// 一切ダウンロードしない。

// NEXT LIVE 用の日時表示
const nextLiveDateFmt = (d: Date, timeTbd: boolean) => {
  const parts = new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(d);
  const pick = (type: string) => parts.find(p => p.type === type)?.value || '';
  const base = `${pick('year')}年${pick('month')}月${pick('day')}日(${pick('weekday')})`;
  return timeTbd ? `${base} 時間未定` : `${base} ${pick('hour')}:${pick('minute')}`;
};
---

<Layout
  title="なんちゃらアイドル公式サイト | ライブ予定・スケジュール"
  description="なんちゃらアイドル公式サイト。東京を中心に活動するアイドルグループのライブ予定・スケジュール、出演履歴、音源情報を掲載しています。"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={musicGroupJsonLd}></script>
    <script is:inline type="application/ld+json" set:html={webSiteJsonLd}></script>
  </Fragment>
  <p class="site-introduction">
    なんちゃらアイドルは、東京を中心にライブハウスや各地のイベントで活動するアイドルグループです。最新のライブ予定や出演履歴、音源情報をご案内します。
  </p>
  {nextLive && (
    <a
      class="next-live"
      href={`/events/${nextLive.slug}`}
      data-date={new Date(nextLive.date).getTime()}
    >
      <div class="next-live-badge">
        <i class="fa-solid fa-star" aria-hidden="true"></i> NEXT LIVE
      </div>
      <div class="next-live-inner">
        {nextLive.images && nextLive.images.length > 0 && (
          <img
            class="next-live-flyer"
            src={nextLive.images[0]}
            alt={`${nextLive.title} のフライヤー`}
            loading="eager"
          />
        )}
        <div class="next-live-info">
          <div class="next-live-date">{nextLiveDateFmt(new Date(nextLive.date), !!nextLive.time_tbd)}</div>
          <h2 class="next-live-title">{nextLive.title}</h2>
          <div class="next-live-site">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            {nextLive.site}
          </div>
          <div class="next-live-countdown" id="next-live-countdown"></div>
        </div>
      </div>
    </a>
  )}

  <div class="schedule-controls">
    <div class="filter-buttons">
      <button class="filter-btn active" data-filter="upcoming">
        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i> 今後の予定
      </button>
      <button class="filter-btn" data-filter="past">
        <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> 過去の予定
      </button>
      <button class="filter-btn" data-filter="all">
        <i class="fa-solid fa-list" aria-hidden="true"></i> すべて
      </button>
    </div>

    <div class="search-box">
      <i class="search-icon fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input
        type="text"
        id="search-input"
        placeholder="イベント名や会場を検索..."
        class="search-input"
      />
    </div>
  </div>

  <div
    id="month-jump-overlay"
    class="month-jump-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="month-jump-label"
  >
    <div class="month-jump-box">
      <label id="month-jump-label" for="month-jump-select">年月を選択してジャンプ</label>
      <select id="month-jump-select"></select>
    </div>
  </div>

  <div id="schedule-list" class="schedule-list" data-mode="upcoming">
    {upcomingSchedules.length === 0 ? (
      <div class="empty-state">
        <div class="title">予定はありません</div>
        <p>現在、予定されているイベントはありません。</p>
      </div>
    ) : (
      monthGroups.map(group => (
        <section class="month-group" data-month={group.key}>
          <h2 class="month-heading">
            <button type="button" class="month-heading-btn"><span>{group.label}</span></button>
          </h2>
          <div class="month-items">
            {group.items.map(schedule => (
              <div
                class="schedule-item"
                data-date={new Date(schedule.date).getTime()}
                data-title={schedule.title.toLowerCase()}
                data-site={schedule.site.toLowerCase()}
                data-labels={(schedule.labels ?? []).join(' ').toLowerCase()}
              >
                <ScheduleCard
                  date={new Date(schedule.date)}
                  title={schedule.title}
                  site={schedule.site}
                  content={schedule.content}
                  images={schedule.images}
                  slug={schedule.slug}
                  labels={schedule.labels}
                />
              </div>
            ))}
          </div>
        </section>
      ))
    )}
  </div>

  <div id="scroll-sentinel"></div>

  <div id="no-results" class="empty-state" style="display: none;">
    <div class="title">該当するイベントがありません</div>
    <p>検索条件を変更してください。</p>
  </div>
</Layout>

<style>
  .site-introduction {
    max-width: 760px;
    margin: 0 auto 24px;
    padding: 0 20px;
    line-height: 1.8;
    text-align: center;
    color: var(--text-light);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('search-input');
    const scheduleList = document.getElementById('schedule-list');
    const noResults = document.getElementById('no-results');
    const sentinel = document.getElementById('scroll-sentinel');

    // 12時間ルール: クライアント側で現在時刻から再計算（ビルド時の値だと古くなるため）
    const clientExpireTime = Date.now() - 12 * 60 * 60 * 1000;

    // サーバーが描画した「今後の予定」のDOMを保持しておき、'upcoming' に戻ったときに再利用する
    // （件数が少なく増え続けないので毎回JSで作り直す必要がない）
    const originalUpcomingHTML = scheduleList ? scheduleList.innerHTML : '';

    // 「過去/すべて」用の軽量イベントデータは /events.json から遅延取得する（lazy load）。
    // 過去イベントはXアーカイブ発掘で今後も増え続けるため、ユーザーが実際に「過去」「すべて」を
    // 選ぶまではダウンロードしない。一度取得したら使い回す（キャッシュ）。
    let allEvents = null;
    let allEventsPromise = null;
    const ensureAllEventsLoaded = () => {
      if (allEvents) return Promise.resolve(allEvents);
      if (!allEventsPromise) {
        allEventsPromise = fetch('/events.json')
          .then((r) => r.json())
          .then((data) => {
            allEvents = Array.isArray(data) ? data : [];
            return allEvents;
          })
          .catch(() => {
            allEvents = [];
            return allEvents;
          });
      }
      return allEventsPromise;
    };

    const monthPartsFmt = new Intl.DateTimeFormat('ja-JP', {
      timeZone: 'Asia/Tokyo',
      year: 'numeric',
      month: '2-digit',
    });
    const monthKeyLabel = (epochMs) => {
      const parts = monthPartsFmt.formatToParts(new Date(epochMs));
      const year = parts.find(p => p.type === 'year')?.value ?? '';
      const month = parts.find(p => p.type === 'month')?.value ?? '';
      return { key: `${year}-${month}`, label: `${year}年${Number(month)}月` };
    };
    const dateFmt = new Intl.DateTimeFormat('ja-JP', {
      timeZone: 'Asia/Tokyo',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      weekday: 'short',
    });
    const dateParts = (epochMs) => {
      const parts = dateFmt.formatToParts(new Date(epochMs));
      const pick = (t) => parts.find(p => p.type === t)?.value || '';
      return { year: Number(pick('year')), month: pick('month'), day: pick('day'), weekday: pick('weekday') };
    };

    // ScheduleCard.astro と同じマークアップ・クラス名でカードDOMを組み立てる
    // （CSSは ScheduleCard.astro 側で is:global 化して共有している）。
    // すべて DOM API / textContent 経由で構築し、innerHTML への文字列埋め込みはしない（XSS対策）。
    const buildCard = (ev) => {
      const d = dateParts(ev.t);
      const accentClass = ev.l?.includes('マミソロ') ? 'accent-red' : ev.l?.includes('あおはるソロ') ? 'accent-blue' : '';

      const a = document.createElement('a');
      a.className = 'schedule-card-link';
      a.href = `/events/${ev.sl}`;

      const article = document.createElement('article');
      article.className = accentClass ? `schedule-card ${accentClass}` : 'schedule-card';

      const header = document.createElement('div');
      header.className = ev.im ? 'card-header has-image' : 'card-header stripe-pattern';
      if (ev.im) header.style.backgroundImage = 'url(' + JSON.stringify(ev.im) + ')';

      const headerTop = document.createElement('div');
      headerTop.className = 'header-top';

      const dateBadge = document.createElement('div');
      dateBadge.className = 'date-badge';
      const yearSpan = document.createElement('span');
      yearSpan.className = 'date-year';
      yearSpan.textContent = String(d.year);
      const mainSpan = document.createElement('span');
      mainSpan.className = 'date-main';
      mainSpan.textContent = `${d.month}/${d.day}`;
      const weekdaySpan = document.createElement('span');
      weekdaySpan.className = 'date-weekday';
      weekdaySpan.textContent = `(${d.weekday})`;
      dateBadge.append(yearSpan, mainSpan, weekdaySpan);
      headerTop.appendChild(dateBadge);

      if (ev.l && ev.l.length > 0) {
        const labelsContainer = document.createElement('div');
        labelsContainer.className = 'labels-container';
        ev.l.forEach((label) => {
          const tag = document.createElement('span');
          const labelClass = label === 'マミソロ' ? 'label-red' : label === 'あおはるソロ' ? 'label-blue' : '';
          tag.className = labelClass ? `label-tag ${labelClass}` : 'label-tag';
          tag.textContent = label;
          labelsContainer.appendChild(tag);
        });
        headerTop.appendChild(labelsContainer);
      }
      header.appendChild(headerTop);

      const titleEl = document.createElement('h3');
      titleEl.className = 'card-title';
      titleEl.textContent = ev.ti;
      header.appendChild(titleEl);

      const body = document.createElement('div');
      body.className = 'card-body';

      const venueInfo = document.createElement('div');
      venueInfo.className = 'venue-info';
      const venueIcon = document.createElement('i');
      venueIcon.className = 'venue-icon fa-solid fa-location-dot';
      venueIcon.setAttribute('aria-hidden', 'true');
      const venueName = document.createElement('span');
      venueName.className = 'venue-name';
      venueName.textContent = ev.s;
      venueInfo.append(venueIcon, venueName);
      body.appendChild(venueInfo);

      const trimmed = (ev.c || '').trim();
      const isTBD = trimmed === 'TBD' || trimmed.startsWith('TBD\n');
      const displayContent = isTBD ? trimmed.replace(/^TBD\s*/, '') : trimmed;

      if (isTBD) {
        const notice = document.createElement('div');
        notice.className = 'tbd-notice';
        const icon = document.createElement('i');
        icon.className = 'fa-solid fa-bullhorn';
        icon.setAttribute('aria-hidden', 'true');
        const span = document.createElement('span');
        span.textContent = '詳細は後日発表';
        notice.append(icon, span);
        body.appendChild(notice);
      }

      if (displayContent) {
        const isLong = displayContent.split('\n').length > 12;
        const details = document.createElement('div');
        details.className = isLong ? 'event-details clamped' : 'event-details';
        details.textContent = displayContent;
        body.appendChild(details);

        if (isLong) {
          const readMore = document.createElement('div');
          readMore.className = 'read-more';
          readMore.append('続きは詳細ページで ');
          const icon = document.createElement('i');
          icon.className = 'fa-solid fa-angles-right';
          icon.setAttribute('aria-hidden', 'true');
          readMore.appendChild(icon);
          body.appendChild(readMore);
        }
      }

      article.append(header, body);
      a.appendChild(article);
      return a;
    };

    // ---- 「過去/すべて」用のフィルタ・並び替え・無限スクロール描画 ----
    const BATCH_SIZE = 30;
    let filteredSorted = [];
    let renderedCount = 0;
    const sectionsByKey = new Map();

    const computeFiltered = (searchTerm) => {
      const desc = currentFilter === 'past';
      const arr = (allEvents || []).filter((ev) => {
        let matchesFilter = true;
        if (currentFilter === 'upcoming') matchesFilter = ev.t >= clientExpireTime;
        else if (currentFilter === 'past') matchesFilter = ev.t < clientExpireTime;
        const haystack = `${ev.ti} ${ev.s} ${(ev.l || []).join(' ')}`.toLowerCase();
        const matchesSearch = !searchTerm || haystack.includes(searchTerm);
        return matchesFilter && matchesSearch;
      });
      arr.sort((a, b) => (desc ? b.t - a.t : a.t - b.t));
      return arr;
    };

    const renderNextBatch = () => {
      if (!scheduleList) return;
      const end = Math.min(renderedCount + BATCH_SIZE, filteredSorted.length);
      for (let i = renderedCount; i < end; i++) {
        const ev = filteredSorted[i];
        const { key, label } = monthKeyLabel(ev.t);
        let section = sectionsByKey.get(key);
        if (!section) {
          section = document.createElement('section');
          section.className = 'month-group';
          section.dataset.month = key;
          const heading = document.createElement('h2');
          heading.className = 'month-heading';
          const headingBtn = document.createElement('button');
          headingBtn.type = 'button';
          headingBtn.className = 'month-heading-btn';
          const span = document.createElement('span');
          span.textContent = label;
          headingBtn.appendChild(span);
          heading.appendChild(headingBtn);
          const itemsWrap = document.createElement('div');
          itemsWrap.className = 'month-items';
          section.append(heading, itemsWrap);
          scheduleList.appendChild(section);
          sectionsByKey.set(key, section);
        }
        const wrap = section.querySelector('.month-items');
        const item = document.createElement('div');
        item.className = 'schedule-item';
        item.appendChild(buildCard(ev));
        wrap.appendChild(item);
      }
      renderedCount = end;
    };

    // ---- 「今後の予定」用のフィルタ（サーバー描画済みDOMをそのまま検索対象にする） ----
    const filterUpcomingDom = (searchTerm) => {
      if (!scheduleList) return 0;
      const items = Array.from(scheduleList.querySelectorAll('.schedule-item'));
      const groups = Array.from(scheduleList.querySelectorAll('.month-group'));
      let visibleCount = 0;
      items.forEach((item) => {
        const haystack = [item.dataset.title, item.dataset.site, item.dataset.labels].join(' ');
        const visible = !searchTerm || haystack.includes(searchTerm);
        item.style.display = visible ? 'block' : 'none';
        if (visible) visibleCount++;
      });
      groups.forEach((group) => {
        const hasVisible = Array.from(group.querySelectorAll('.schedule-item'))
          .some((item) => item.style.display !== 'none');
        group.style.display = hasVisible ? 'block' : 'none';
      });
      return visibleCount;
    };

    // URLクエリから初期状態を復元（?filter=past&q=渋谷 みたいに共有できる）
    const params = new URLSearchParams(location.search);
    let currentFilter = params.get('filter') || 'upcoming';
    if (!['upcoming', 'past', 'all'].includes(currentFilter)) currentFilter = 'upcoming';
    if (searchInput && params.get('q')) searchInput.value = params.get('q');

    const syncURL = () => {
      const p = new URLSearchParams();
      if (currentFilter !== 'upcoming') p.set('filter', currentFilter);
      const q = searchInput ? searchInput.value.trim() : '';
      if (q) p.set('q', q);
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
    };

    // 戻り値のPromiseは「描画が完全に終わった後」にだけ処理したい呼び出し元
    // （年月ジャンプ機能）のためのもの。フィルタボタン等の通常呼び出しは戻り値を無視してよい。
    const render = () => {
      if (!scheduleList) return Promise.resolve();
      const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';

      if (currentFilter === 'upcoming') {
        if (scheduleList.dataset.mode !== 'upcoming') {
          scheduleList.innerHTML = originalUpcomingHTML;
          scheduleList.dataset.mode = 'upcoming';
        }
        const visibleCount = filterUpcomingDom(searchTerm);
        scheduleList.style.display = visibleCount > 0 ? 'block' : 'none';
        if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        return Promise.resolve();
      }

      // 「過去/すべて」: 初回だけ /events.json を取得する（取得中は簡単なローディング表示）
      scheduleList.dataset.mode = currentFilter;
      if (noResults) noResults.style.display = 'none';
      scheduleList.style.display = 'block';
      scheduleList.innerHTML = '<div class="empty-state"><div class="title">読み込み中...</div></div>';

      const requestFilter = currentFilter;
      const requestSearch = searchTerm;
      return ensureAllEventsLoaded().then(() => {
        // 取得中にユーザーがフィルタや検索語を変えていたら、この結果は捨てて最新の render() に任せる
        const stillCurrentSearch = searchInput ? searchInput.value.toLowerCase().trim() : '';
        if (currentFilter !== requestFilter || stillCurrentSearch !== requestSearch) return;

        scheduleList.innerHTML = '';
        sectionsByKey.clear();
        filteredSorted = computeFiltered(requestSearch);
        renderedCount = 0;
        renderNextBatch();
        const visibleCount = filteredSorted.length;
        scheduleList.style.display = visibleCount > 0 ? 'block' : 'none';
        if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        // 初回バッチが画面に収まりきってしまう場合に備えて、描画直後にも一度チェックする
        checkScrollForMore();
      });
    };

    const applyFilter = () => {
      filterButtons.forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.filter === currentFilter);
      });
      const pending = render();
      syncURL();
      return pending;
    };

    // スクロールが下端に近づいたら「過去/すべて」の続きを少しずつ描画する（無限スクロール）。
    // IntersectionObserver ではなく scroll/resize イベント＋setTimeoutの軽いスロットルで実装する
    // （IntersectionObserver はブラウザのコンポジタのタイミングに依存し、環境によっては
    // レンダリングループが回っていないと発火が遅れる/しないことがあるため、より確実なこちらを採用）。
    let scrollCheckPending = false;
    const checkScrollForMore = () => {
      if (scrollCheckPending) return;
      scrollCheckPending = true;
      setTimeout(() => {
        scrollCheckPending = false;
        if (!scheduleList || !sentinel || scheduleList.dataset.mode === 'upcoming') return;
        if (renderedCount >= filteredSorted.length) return;
        const rect = sentinel.getBoundingClientRect();
        if (rect.top <= window.innerHeight + 1000) {
          renderNextBatch();
          // 1バッチ描画してもまだ画面近くにsentinelが残っていれば続けて描画する
          // （ジャンプスクロールや縦長ビューポートで1バッチでは足りないケースに対応）
          checkScrollForMore();
        }
      }, 100);
    };
    if (sentinel) {
      window.addEventListener('scroll', checkScrollForMore, { passive: true });
      window.addEventListener('resize', checkScrollForMore, { passive: true });
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        currentFilter = button.dataset.filter || 'all';
        applyFilter();
      });
    });

    // ---- 月見出しクリックで年月ピッカーを開き、任意の月にジャンプする ----
    const monthJumpOverlay = document.getElementById('month-jump-overlay');
    const monthJumpSelect = document.getElementById('month-jump-select');
    let monthJumpLastFocused = null;
    // 全期間の年月一覧はイベント数が増えても変わらないので一度作ったらキャッシュする
    let monthJumpKeysCache = null;

    const closeMonthJump = () => {
      if (monthJumpOverlay) monthJumpOverlay.hidden = true;
      // モーダルを開く前にフォーカスしていた要素（＝クリックした見出しボタン）に戻す
      if (monthJumpLastFocused && typeof monthJumpLastFocused.focus === 'function') {
        monthJumpLastFocused.focus();
      }
      monthJumpLastFocused = null;
    };

    const openMonthJump = (preferredKey) => {
      if (!monthJumpOverlay || !monthJumpSelect) return;
      monthJumpLastFocused = document.activeElement;
      ensureAllEventsLoaded().then((events) => {
        if (!monthJumpKeysCache) {
          const labelByKey = new Map();
          events.forEach((ev) => {
            const { key, label } = monthKeyLabel(ev.t);
            if (!labelByKey.has(key)) labelByKey.set(key, label);
          });
          monthJumpKeysCache = Array.from(labelByKey.entries()).sort((a, b) => (a[0] < b[0] ? -1 : 1));
        }
        const keys = monthJumpKeysCache;
        if (keys.length === 0) return;
        monthJumpSelect.innerHTML = '';
        keys.forEach(([key, label]) => {
          const opt = document.createElement('option');
          opt.value = key;
          opt.textContent = label;
          monthJumpSelect.appendChild(opt);
        });
        // クリックした見出しの月があればそれを初期選択にする。無ければ現在表示中の
        // フィルターに近い月（今後→末尾、過去/すべて→先頭寄り）にフォールバックする
        const hasPreferred = preferredKey && keys.some(([key]) => key === preferredKey);
        monthJumpSelect.value = hasPreferred
          ? preferredKey
          : currentFilter === 'upcoming' ? keys[keys.length - 1][0] : keys[0][0];
        monthJumpOverlay.hidden = false;
        monthJumpSelect.focus();
      });
    };

    // 対象の月セクションが見つかるまでバッチ描画を進めてからスクロールする。
    // renderNextBatchをwhileで同期的に回すとイベント数が多いときメインスレッドを長時間
    // ブロックしうるため、rAFで1バッチずつブラウザに制御を返しながら進める
    const jumpToMonth = (key) => {
      closeMonthJump();
      currentFilter = 'all';
      // 検索語が残っていると、ジャンプ先の月に検索条件に一致するイベントが1件もない場合、
      // 全件描画してもセクションが見つからず「クリックしたのに何も起きない」ように見えるバグに
      // なるため、月ジャンプ時は検索語をクリアする
      if (searchInput) searchInput.value = '';
      Promise.resolve(applyFilter()).then(() => {
        // requestAnimationFrame はブラウザのコンポジタ/描画フレームに依存しており、
        // headless/自動化されたレンダリングコンテキストでは発火しないことがある
        // （2026-07-05 IntersectionObserverで確認済みの既知の制約と同根、2026-07-10
        // 本機能でも実測で確認）。より確実な setTimeout ベースで1バッチずつ制御を返す
        const step = () => {
          const section = sectionsByKey.get(key);
          if (section) {
            // behavior: 'smooth' も同じ理由で信頼できないため、確実性を優先して即時ジャンプにする
            section.scrollIntoView({ behavior: 'auto', block: 'start' });
            return;
          }
          if (renderedCount >= filteredSorted.length) return; // データ不整合等で見つからない
          renderNextBatch();
          setTimeout(step, 0);
        };
        step();
      });
    };

    // サーバー描画済み・クライアント生成済みどちらの月見出しにも効くようイベント委任にする
    if (scheduleList) {
      scheduleList.addEventListener('click', (e) => {
        const btn = e.target.closest('.month-heading-btn');
        if (!btn) return;
        const section = btn.closest('.month-group');
        openMonthJump(section ? section.dataset.month : undefined);
      });
    }
    if (monthJumpSelect) {
      monthJumpSelect.addEventListener('change', () => jumpToMonth(monthJumpSelect.value));
    }
    if (monthJumpOverlay) {
      monthJumpOverlay.addEventListener('click', (e) => {
        if (e.target === monthJumpOverlay) closeMonthJump();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && monthJumpOverlay && !monthJumpOverlay.hidden) closeMonthJump();
    });

    if (searchInput) {
      // 検索は軽い処理だが連打時のちらつきを抑えるため軽くデバウンスする
      let searchDebounce;
      searchInput.addEventListener('input', () => {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(() => {
          render();
          syncURL();
        }, 120);
      });
    }

    // NEXT LIVE カウントダウン
    const hero = document.querySelector('.next-live');
    const countdown = document.getElementById('next-live-countdown');
    if (hero && countdown) {
      const eventTime = parseInt(hero.dataset.date || '0');
      const now = Date.now();
      const jstDay = (t) => new Date(t).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
      const THREE_DAYS_MS = 3 * 24 * 60 * 60 * 1000;
      if (eventTime < clientExpireTime) {
        // ビルドが古くてイベントが終わっている場合は隠す
        hero.style.display = 'none';
      } else if (jstDay(eventTime) === jstDay(now)) {
        countdown.textContent = '🎤 本日開催!';
        countdown.classList.add('today');
      } else if (eventTime - now < THREE_DAYS_MS) {
        // 残り3日を切ったら日・時・分・秒まで毎秒カウントダウン表示
        let timer;
        const tick = () => {
          const remaining = eventTime - Date.now();
          if (remaining <= 0) {
            countdown.textContent = '🎤 開演中!';
            countdown.classList.add('today');
            if (timer) clearInterval(timer);
            return;
          }
          const d = Math.floor(remaining / (24 * 60 * 60 * 1000));
          const h = Math.floor((remaining % (24 * 60 * 60 * 1000)) / (60 * 60 * 1000));
          const m = Math.floor((remaining % (60 * 60 * 1000)) / (60 * 1000));
          const s = Math.floor((remaining % (60 * 1000)) / 1000);
          if (d > 0) {
            countdown.textContent = `あと ${d}日 ${h}時間 ${m}分 ${s}秒`;
          } else if (h > 0) {
            countdown.textContent = `あと ${h}時間 ${m}分 ${s}秒`;
          } else if (m > 0) {
            countdown.textContent = `あと ${m}分 ${s}秒`;
          } else {
            countdown.textContent = `あと ${s}秒`;
          }
        };
        tick();
        timer = setInterval(tick, 1000);
      } else {
        const days = Math.ceil((eventTime - now) / (24 * 60 * 60 * 1000));
        countdown.textContent = `あと ${days}日`;
      }
    }

    // 初期表示
    applyFilter();
  });
</script>

