---
import Layout from '../layouts/Layout.astro';
import ScheduleCard from '../components/ScheduleCard.astro';
import { loadAllSchedules } from '../utils/schedules';

// YAMLファイル読み込み（全ての schedules/*.yml を統合）
const allSchedules = loadAllSchedules();

// 昇順（古→新）の全イベント
const schedules = [...allSchedules].sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
);

// 12時間ルール: 現在時刻 - 12時間を基準に「今後」を判定（クライアント側でも再計算する）
const expireTime = Date.now() - 12 * 60 * 60 * 1000;

// NEXT LIVE（直近の今後イベント）
const nextLive = schedules.find(s => new Date(s.date).getTime() >= expireTime) ?? null;

// 月ごとにグルーピング（JST基準）
const monthPartsFmt = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
});

const monthGroups: { key: string; label: string; items: typeof schedules }[] = [];
for (const schedule of schedules) {
  const parts = monthPartsFmt.formatToParts(new Date(schedule.date));
  const year = parts.find(p => p.type === 'year')?.value ?? '';
  const month = parts.find(p => p.type === 'month')?.value ?? '';
  const key = `${year}-${month}`;
  let group = monthGroups.find(g => g.key === key);
  if (!group) {
    group = { key, label: `${year}年${Number(month)}月`, items: [] };
    monthGroups.push(group);
  }
  group.items.push(schedule);
}

// NEXT LIVE 用の日時表示
const nextLiveDateFmt = (d: Date, timeTbd: boolean) => {
  const parts = new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(d);
  const pick = (type: string) => parts.find(p => p.type === type)?.value || '';
  const base = `${pick('year')}年${pick('month')}月${pick('day')}日(${pick('weekday')})`;
  return timeTbd ? `${base} 時間未定` : `${base} ${pick('hour')}:${pick('minute')}`;
};
---

<Layout
  title="ライブ予定 | なんちゃらアイドル"
  description="なんちゃらアイドルのライブ・イベントスケジュール"
>
  {nextLive && (
    <a
      class="next-live"
      href={`/events/${nextLive.slug}`}
      data-date={new Date(nextLive.date).getTime()}
    >
      <div class="next-live-badge">
        <i class="fa-solid fa-star" aria-hidden="true"></i> NEXT LIVE
      </div>
      <div class="next-live-inner">
        {nextLive.images && nextLive.images.length > 0 && (
          <img
            class="next-live-flyer"
            src={nextLive.images[0]}
            alt={`${nextLive.title} のフライヤー`}
            loading="eager"
          />
        )}
        <div class="next-live-info">
          <div class="next-live-date">{nextLiveDateFmt(new Date(nextLive.date), !!nextLive.time_tbd)}</div>
          <h2 class="next-live-title">{nextLive.title}</h2>
          <div class="next-live-site">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            {nextLive.site}
          </div>
          <div class="next-live-countdown" id="next-live-countdown"></div>
        </div>
      </div>
    </a>
  )}

  <div class="schedule-controls">
    <div class="filter-buttons">
      <button class="filter-btn active" data-filter="upcoming">
        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i> 今後の予定
      </button>
      <button class="filter-btn" data-filter="past">
        <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> 過去の予定
      </button>
      <button class="filter-btn" data-filter="all">
        <i class="fa-solid fa-list" aria-hidden="true"></i> すべて
      </button>
    </div>

    <div class="search-box">
      <i class="search-icon fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input
        type="text"
        id="search-input"
        placeholder="イベント名や会場を検索..."
        class="search-input"
      />
    </div>
  </div>

  <div id="schedule-list" class="schedule-list">
    {schedules.length === 0 ? (
      <div class="empty-state">
        <div class="title">予定はありません</div>
        <p>現在、予定されているイベントはありません。</p>
      </div>
    ) : (
      monthGroups.map(group => (
        <section class="month-group" data-month={group.key}>
          <h2 class="month-heading"><span>{group.label}</span></h2>
          <div class="month-items">
            {group.items.map(schedule => (
              <div
                class="schedule-item"
                data-date={new Date(schedule.date).getTime()}
                data-title={schedule.title.toLowerCase()}
                data-site={schedule.site.toLowerCase()}
                data-labels={(schedule.labels ?? []).join(' ').toLowerCase()}
              >
                <ScheduleCard
                  date={new Date(schedule.date)}
                  title={schedule.title}
                  site={schedule.site}
                  content={schedule.content}
                  images={schedule.images}
                  slug={schedule.slug}
                  labels={schedule.labels}
                />
              </div>
            ))}
          </div>
        </section>
      ))
    )}
  </div>

  <div id="no-results" class="empty-state" style="display: none;">
    <div class="title">該当するイベントがありません</div>
    <p>検索条件を変更してください。</p>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('search-input');
    const scheduleList = document.getElementById('schedule-list');
    const scheduleItems = Array.from(document.querySelectorAll('.schedule-item'));
    const monthGroups = Array.from(document.querySelectorAll('.month-group'));
    const noResults = document.getElementById('no-results');

    // 12時間ルール: クライアント側で現在時刻から再計算（ビルド時の値だと古くなるため）
    const clientExpireTime = Date.now() - 12 * 60 * 60 * 1000;

    // URLクエリから初期状態を復元（?filter=past&q=渋谷 みたいに共有できる）
    const params = new URLSearchParams(location.search);
    let currentFilter = params.get('filter') || 'upcoming';
    if (!['upcoming', 'past', 'all'].includes(currentFilter)) currentFilter = 'upcoming';
    if (searchInput && params.get('q')) searchInput.value = params.get('q');

    const syncURL = () => {
      const p = new URLSearchParams();
      if (currentFilter !== 'upcoming') p.set('filter', currentFilter);
      const q = searchInput ? searchInput.value.trim() : '';
      if (q) p.set('q', q);
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
    };

    // 並び順: 今後・すべて=昇順（直近が上）、過去=降順（新しい過去が上）
    const applyOrder = (desc) => {
      if (!scheduleList) return;
      const groups = [...monthGroups].sort((a, b) => {
        const ka = a.dataset.month || '';
        const kb = b.dataset.month || '';
        return desc ? kb.localeCompare(ka) : ka.localeCompare(kb);
      });
      groups.forEach(g => scheduleList.appendChild(g));
      groups.forEach(g => {
        const wrap = g.querySelector('.month-items');
        if (!wrap) return;
        const items = Array.from(wrap.children).sort((x, y) => {
          const dx = parseInt(x.dataset.date || '0');
          const dy = parseInt(y.dataset.date || '0');
          return desc ? dy - dx : dx - dy;
        });
        items.forEach(i => wrap.appendChild(i));
      });
    };

    const filterSchedules = () => {
      const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      scheduleItems.forEach(item => {
        const date = parseInt(item.dataset.date || '0');
        const haystack = [item.dataset.title, item.dataset.site, item.dataset.labels].join(' ');

        let matchesFilter = true;
        if (currentFilter === 'upcoming') {
          matchesFilter = date >= clientExpireTime;
        } else if (currentFilter === 'past') {
          matchesFilter = date < clientExpireTime;
        }

        const matchesSearch = !searchTerm || haystack.includes(searchTerm);
        const visible = matchesFilter && matchesSearch;
        item.style.display = visible ? 'block' : 'none';
        if (visible) visibleCount++;
      });

      // イベントが1件も見えない月は月見出しごと隠す
      monthGroups.forEach(group => {
        const hasVisible = Array.from(group.querySelectorAll('.schedule-item'))
          .some(item => item.style.display !== 'none');
        group.style.display = hasVisible ? 'block' : 'none';
      });

      if (scheduleList) scheduleList.style.display = visibleCount > 0 ? 'block' : 'none';
      if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    };

    const applyFilter = () => {
      filterButtons.forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === currentFilter);
      });
      applyOrder(currentFilter === 'past');
      filterSchedules();
      syncURL();
    };

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        currentFilter = button.dataset.filter || 'all';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        filterSchedules();
        syncURL();
      });
    }

    // NEXT LIVE カウントダウン
    const hero = document.querySelector('.next-live');
    const countdown = document.getElementById('next-live-countdown');
    if (hero && countdown) {
      const eventTime = parseInt(hero.dataset.date || '0');
      const now = Date.now();
      const jstDay = (t) => new Date(t).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
      if (eventTime < clientExpireTime) {
        // ビルドが古くてイベントが終わっている場合は隠す
        hero.style.display = 'none';
      } else if (jstDay(eventTime) === jstDay(now)) {
        countdown.textContent = '🎤 本日開催!';
        countdown.classList.add('today');
      } else {
        const days = Math.ceil((eventTime - now) / (24 * 60 * 60 * 1000));
        countdown.textContent = `あと${days}日`;
      }
    }

    // 初期表示
    applyFilter();
  });
</script>

<style>
  /* ==========================================
     NEXT LIVE ヒーロー
     ========================================== */
  .next-live {
    display: block;
    width: 100%;
    max-width: 900px;
    margin: 0 auto 40px;
    position: relative;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(135deg, var(--bg-medium) 0%, var(--bg-dark) 100%);
    border: 3px solid var(--retro-cyan);
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 6px 0 rgba(0, 0, 0, 0.3),
      0 0 30px rgba(0, 255, 255, 0.4);
    transition: all 0.3s ease;
  }

  .next-live:hover {
    transform: translateY(-4px);
    box-shadow:
      0 10px 0 rgba(0, 0, 0, 0.3),
      0 0 40px rgba(0, 255, 255, 0.6),
      0 0 60px rgba(255, 110, 199, 0.3);
  }

  .next-live-badge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 8px 20px;
    background: linear-gradient(135deg, var(--retro-cyan) 0%, var(--retro-purple) 100%);
    color: white;
    font-family: var(--font-digital);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 2px;
    border-radius: 0 0 12px 0;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
  }

  .next-live-inner {
    display: flex;
    align-items: stretch;
  }

  .next-live-flyer {
    width: 40%;
    max-height: 320px;
    object-fit: cover;
    object-position: top;
    flex-shrink: 0;
  }

  .next-live-info {
    flex: 1;
    padding: 48px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
  }

  .next-live-date {
    font-family: var(--font-digital);
    font-size: 1rem;
    color: var(--retro-yellow);
    text-shadow: 0 0 8px rgba(255, 214, 10, 0.5);
    letter-spacing: 1px;
  }

  .next-live-title {
    font-size: 1.6rem;
    line-height: 1.4;
    margin: 0;
  }

  .next-live-site {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--pastel-pink);
    font-weight: 600;
  }

  .next-live-site i {
    color: var(--retro-pink);
  }

  .next-live-countdown {
    font-family: var(--font-digital);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--retro-cyan);
    text-shadow: 0 0 12px rgba(0, 255, 255, 0.6);
    letter-spacing: 2px;
  }

  .next-live-countdown.today {
    color: var(--retro-pink);
    text-shadow: 0 0 12px rgba(255, 110, 199, 0.8);
    animation: neon-flicker 3s infinite alternate;
  }

  @media (max-width: 768px) {
    .next-live-inner {
      flex-direction: column;
    }

    .next-live-flyer {
      width: 100%;
      max-height: 240px;
    }

    .next-live-info {
      padding: 20px;
    }

    .next-live-title {
      font-size: 1.3rem;
    }
  }

  /* ==========================================
     コントロール（フィルタ・検索）
     ========================================== */
  .schedule-controls {
    max-width: 1280px;
    margin: 0 auto 30px;
    padding: 0 20px;
  }

  .filter-buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .filter-btn {
    padding: 12px 24px;
    background: linear-gradient(135deg, var(--retro-purple) 0%, var(--retro-pink) 100%);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 25px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.3),
      0 0 15px rgba(255, 110, 199, 0.4);
  }

  .filter-btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 0 rgba(0, 0, 0, 0.3),
      0 0 25px rgba(255, 110, 199, 0.6);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, var(--retro-cyan) 0%, var(--retro-purple) 100%);
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.3),
      0 0 25px rgba(0, 255, 255, 0.6);
  }

  .search-box {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }

  .search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--pastel-pink);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 14px 20px 14px 48px;
    font-size: 1rem;
    background: rgba(26, 26, 46, 0.8);
    border: 2px solid var(--retro-pink);
    border-radius: 30px;
    color: var(--text-light);
    outline: none;
    transition: all 0.3s ease;
    box-shadow:
      0 0 15px rgba(255, 110, 199, 0.3),
      inset 0 0 10px rgba(0, 0, 0, 0.3);
  }

  .search-input::placeholder {
    color: var(--pastel-pink);
  }

  .search-input:focus {
    border-color: var(--retro-cyan);
    box-shadow:
      0 0 25px rgba(0, 255, 255, 0.5),
      inset 0 0 10px rgba(0, 0, 0, 0.3);
  }

  /* ==========================================
     月グルーピングされたスケジュール一覧
     ========================================== */
  .schedule-list {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .month-group {
    margin-bottom: 40px;
  }

  .month-heading {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 0 0 20px;
    padding: 12px 0;
    text-align: center;
    font-family: var(--font-digital);
    font-size: 1.3rem;
    letter-spacing: 2px;
    color: var(--retro-cyan);
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
  }

  .month-heading span {
    display: inline-block;
    padding: 0 24px;
    border-bottom: 2px solid var(--retro-cyan);
  }

  .month-items {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    justify-items: stretch;
  }

  @media (min-width: 900px) {
    .month-items {
      grid-template-columns: repeat(2, 1fr);
      align-items: stretch;
    }
  }

  .schedule-item {
    width: 100%;
  }

  /* レスポンシブ対応 */
  @media (max-width: 768px) {
    .filter-btn {
      font-size: 0.9rem;
      padding: 10px 20px;
    }

    .search-input {
      font-size: 0.95rem;
      padding: 12px 18px 12px 44px;
    }

    .schedule-list {
      padding: 0 10px;
    }
  }

  @media (max-width: 480px) {
    .schedule-controls {
      padding: 0 10px;
    }

    .filter-buttons {
      gap: 8px;
    }

    .filter-btn {
      font-size: 0.85rem;
      padding: 10px 16px;
    }

    .search-input {
      font-size: 0.9rem;
      padding: 12px 16px 12px 42px;
    }
  }

  /* アニメーション無効化（アクセシビリティ） */
  @media (prefers-reduced-motion: reduce) {
    .filter-btn,
    .search-input,
    .next-live {
      transition: none !important;
    }

    .filter-btn:hover,
    .next-live:hover {
      transform: none;
    }

    .next-live-countdown.today {
      animation: none !important;
    }
  }
</style>
