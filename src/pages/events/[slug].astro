---
import Layout from '../../layouts/Layout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { loadAllSchedules } from '../../utils/schedules';
import { resolveVenue } from '../../utils/venues';
import { collectActs, normalizeAct } from '../../utils/acts';
import { buildEventDescription, buildMusicEvent, stringifyStructuredData } from '../../utils/structured-data';

export async function getStaticPaths() {
  const schedules = loadAllSchedules();

  return schedules
    .filter((s: any) => s.slug) // slugがあるイベントのみ
    .map((schedule: any) => ({
      params: { slug: schedule.slug },
      props: { schedule },
    }));
}

interface ScheduleType {
  date: string;
  end?: string;
  title: string;
  site: string;
  content?: string;
  images?: string[];
  slug: string;
  labels?: string[];
  /** 対バン相手（共演アーティスト） */
  acts?: string[];
  /** 開催時刻が未確定（TimeTreeの仮時刻など）の場合 true */
  time_tbd?: boolean;
  /** 情報源（Xの告知ポスト等の出典URL）。/mine-x でバックフィルした過去イベントに付く */
  sources?: string[];
}

const { schedule } = Astro.props as { schedule: ScheduleType };
const { date, end, title, site, content, images, labels, acts, time_tbd, sources } = schedule;

// site を会場マスタに解決（解決できたら正式表記＋会場ページへのリンクを出す）
const venue = resolveVenue(site);

// act チップのリンク先は集計後の正規名（/acts/{名前} のページは正規名でしか生成されない
// ため、生の表記のままリンクすると表記ゆれ分が 404 になる）。
// また href の末尾スラッシュは必須: 省略すると CDN の 308 リダイレクトの Location ヘッダに
// 生のマルチバイトが入り、ブラウザによっては URL が化けて遷移に失敗する
const actIndex = collectActs();
const canonicalActName = (raw: string) => actIndex.get(normalizeAct(raw))?.name ?? raw;

// ラベルの色を決定する関数
const getLabelClass = (label: string) => {
  if (label === 'マミソロ') return 'label-red';
  if (label === 'あおはるソロ') return 'label-blue';
  return '';
};

// 日付フォーマット（日本時間で統一）
const eventDate = new Date(date);
const formatDate = (d: Date) => {
  const formatter = new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  });

  const parts = formatter.formatToParts(d);
  const year = parts.find(p => p.type === 'year')?.value;
  const month = parts.find(p => p.type === 'month')?.value;
  const day = parts.find(p => p.type === 'day')?.value;
  const weekday = parts.find(p => p.type === 'weekday')?.value;
  const hour = parts.find(p => p.type === 'hour')?.value;
  const minute = parts.find(p => p.type === 'minute')?.value;

  // 時刻未確定のイベントは仮時刻を出さない
  if (time_tbd) {
    return `${year}年${month}月${day}日(${weekday}) 時間未定`;
  }
  return `${year}年${month}月${day}日(${weekday}) ${hour}:${minute}`;
};

// Google Calendar用の日付フォーマット（YYYYMMDDTHHmmSSZ - 日本時間）
const formatGoogleCalDate = (d: Date) => {
  const formatter = new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  });

  const parts = formatter.formatToParts(d);
  const year = parts.find(p => p.type === 'year')?.value;
  const month = parts.find(p => p.type === 'month')?.value;
  const day = parts.find(p => p.type === 'day')?.value;
  const hour = parts.find(p => p.type === 'hour')?.value;
  const minute = parts.find(p => p.type === 'minute')?.value;

  return `${year}${month}${day}T${hour}${minute}00`;
};

// イベント終了時刻（endフィールドがあればそれを使用、なければ開始から4時間後）
const eventEndDate = end ? new Date(end) : new Date(eventDate.getTime() + 4 * 60 * 60 * 1000);

// Google Calendar用の日付フォーマット（終日イベント: YYYYMMDD）
const formatGoogleCalDateOnly = (d: Date) => formatGoogleCalDate(d).slice(0, 8);

// Google Calendar URL（時間未定は終日イベントとして登録）
const googleCalendarUrl = new URL('https://calendar.google.com/calendar/render');
googleCalendarUrl.searchParams.set('action', 'TEMPLATE');
googleCalendarUrl.searchParams.set('text', title);
if (time_tbd) {
  const nextDay = new Date(eventDate.getTime() + 24 * 60 * 60 * 1000);
  googleCalendarUrl.searchParams.set('dates', `${formatGoogleCalDateOnly(eventDate)}/${formatGoogleCalDateOnly(nextDay)}`);
} else {
  googleCalendarUrl.searchParams.set('dates', `${formatGoogleCalDate(eventDate)}/${formatGoogleCalDate(eventEndDate)}`);
}
const eventDetailUrl = `https://nantyara.com/events/${schedule.slug}`;
const detailsWithUrl = content ? `${content}\n\nイベント詳細: ${eventDetailUrl}` : `イベント詳細: ${eventDetailUrl}`;
googleCalendarUrl.searchParams.set('details', detailsWithUrl);
googleCalendarUrl.searchParams.set('location', site);
googleCalendarUrl.searchParams.set('ctz', 'Asia/Tokyo');

// OGP用（基本タグは Layout に集約。イベント固有のタグだけ slot で追加）
const ogTitle = `${title} | なんちゃらアイドル`;
const ogDescription = buildEventDescription(`${formatDate(eventDate)} @ ${site}`, acts);
const ogImage = images && images.length > 0 ? images[0] : '/img/ogp-default.png';
const musicEventJsonLd = stringifyStructuredData(buildMusicEvent({
  title,
  date,
  end,
  site,
  slug: schedule.slug,
  time_tbd,
  acts,
  images,
  description: ogDescription,
}, venue));

// TBD（詳細未定）は内部用語をそのまま出さず「詳細は後日発表」に変換
const trimmedContent = (content ?? '').trim();
const isTBD = trimmedContent === 'TBD' || trimmedContent.startsWith('TBD\n');
const displayContent = isTBD ? trimmedContent.replace(/^TBD\s*/, '') : trimmedContent;

// コンテンツ内のURLを自動リンク化する関数
const autoLinkUrls = (text: string): string => {
  if (!text) return '';

  // HTMLエスケープ
  const escapeHtml = (str: string): string => {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  };

  // URL検出の正規表現（http/httpsで始まるURL）
  const urlRegex = /(https?:\/\/[^\s<>"{}|\\^`[\]]+)/g;

  // まずHTMLエスケープしてから、URLをリンクに変換
  const escaped = escapeHtml(text);
  const linked = escaped.replace(urlRegex, '<a href="$1" target="_blank" rel="noopener noreferrer" class="content-link">$1</a>');

  // 改行を<br>に変換
  return linked.replace(/\n/g, '<br>');
};

const contentHtml = displayContent ? autoLinkUrls(displayContent) : '';
---

<Layout title={ogTitle} description={ogDescription} ogImage={ogImage} ogType="article">
  <Fragment slot="head">
    <!-- Event specific -->
    <meta property="event:start_time" content={eventDate.toISOString()} />
    <meta property="event:end_time" content={eventEndDate.toISOString()} />
    <meta property="event:location" content={site} />
    <script is:inline type="application/ld+json" set:html={musicEventJsonLd}></script>
</Fragment>

  <Breadcrumbs items={[
    { label: 'ホーム', href: '/' },
    { label: 'ライブ・イベント', href: '/events/' },
    { label: title },
  ]} />
  <article class="event-detail">
    <div
      class={`event-header ${images && images.length > 0 ? 'has-image' : ''}`}
      style={images && images.length > 0 ? `background-image: url('${images[0]}')` : ''}
    >
      <h1 class="event-title">{title}</h1>
      <div class="event-meta">
        <div class="event-date">{formatDate(eventDate)}</div>
        {labels && labels.length > 0 && (
          <div class="labels-container">
            {labels.map((label) => (
              <span class={`label-tag ${getLabelClass(label)}`}>{label}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="event-info">
      <div class="venue-section">
        <h2 class="section-title">会場</h2>
        <p class="venue-name">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          {venue ? <a href={`/venues/${venue.id}`} class="venue-link">{venue.name}</a> : site}
        </p>
        {venue?.address && <p class="venue-address">{venue.address}</p>}
      </div>

      {acts && acts.length > 0 && (
        <div class="acts-section">
          <h2 class="section-title">共演</h2>
          <div class="acts-chips">
            {acts.map((act) => (
              <a href={`/acts/${encodeURIComponent(canonicalActName(act))}/`} class="act-chip">{act}</a>
            ))}
          </div>
        </div>
      )}

      <div class="actions-section">
        <div class="calendar-buttons">
          <a href={googleCalendarUrl.toString()} target="_blank" rel="noopener noreferrer" class="calendar-button">
            <i class="fa-brands fa-google" aria-hidden="true"></i> Googleカレンダーに追加
          </a>
          <a href={`/events/${schedule.slug}.ics`} class="calendar-button ics-button">
            <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> カレンダーに追加 (.ics)
          </a>
        </div>
        <div class="share-buttons-wrapper">
          <ShareButtons
            url={`https://nantyara.com/events/${schedule.slug}`}
            title={title}
            description={`${formatDate(eventDate)} @ ${site}`}
          />
        </div>
      </div>

      {(isTBD || contentHtml) && (
        <div class="event-content">
          <h2 class="section-title">詳細</h2>
          {isTBD && (
            <div class="tbd-notice">
              <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
              <span>詳細は後日発表</span>
            </div>
          )}
          {contentHtml && <div class="content-text" set:html={contentHtml}></div>}
        </div>
      )}
    </div>

    {images && images.length > 0 && (
      <div class="event-images">
        <h2 class="section-title">画像</h2>
        <div class="image-grid">
          {images.map((img: string) => (
            <img src={img} alt={title} loading="lazy" class="event-image" />
          ))}
        </div>
      </div>
    )}

    {sources && sources.length > 0 && (
      <div class="event-sources">
        <h2 class="section-title">情報源</h2>
        <p class="sources-note">当時のXの告知ポストから復元したイベントです。</p>
        <ul class="sources-list">
          {sources.map((url: string) => (
            <li>
              <a href={url} target="_blank" rel="noopener noreferrer" class="source-link">
                <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
                {url.replace(/^https?:\/\/(x|twitter)\.com\//, '@').replace(/\/status\/\d+.*$/, ' のポスト')}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="back-link-wrapper">
      <a href="/#schedule" class="back-link">
        ← スケジュール一覧に戻る
      </a>
    </div>
  </article>
</Layout>

<style>
  .event-detail {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .event-sources {
    margin-top: 32px;
  }

  .sources-note {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0 0 10px 0;
  }

  .sources-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--retro-cyan);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .source-link:hover {
    text-decoration: underline;
  }

  .event-header {
    text-align: center;
    margin-bottom: 40px;
    padding: 30px;
    background: linear-gradient(135deg, var(--retro-cyan) 0%, var(--retro-purple) 100%);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(255, 110, 199, 0.5);
    border: 2px solid rgba(255, 255, 255, 0.3);
    position: relative;
  }

  .event-header.has-image {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .event-header.has-image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 10px;
    z-index: 0;
  }

  .event-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: white;
    margin: 0 0 15px 0;
    text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.5);
    line-height: 1.3;
    position: relative;
    z-index: 1;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .event-date {
    font-size: 1.2rem;
    color: var(--retro-yellow);
    font-weight: 700;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
  }

  .event-info {
    margin-bottom: 40px;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--retro-pink);
    margin: 0 0 20px 0;
    padding-bottom: 10px;
    border-bottom: 3px solid var(--retro-pink);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.3);
  }

  .venue-section {
    margin-bottom: 30px;
    padding: 25px;
    background: rgba(255, 110, 199, 0.1);
    border: 2px solid var(--retro-pink);
    border-radius: 8px;
    box-shadow: 0 0 15px rgba(255, 110, 199, 0.3);
  }

  .venue-name {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--pastel-pink);
    margin: 0;
  }

  .venue-link {
    color: var(--pastel-pink);
    text-decoration: underline;
    text-decoration-color: rgba(255, 110, 199, 0.6);
    text-underline-offset: 4px;
  }

  .venue-link:hover {
    color: var(--retro-cyan);
  }

  .venue-address {
    margin: 8px 0 0 0;
    font-size: 0.9rem;
    color: var(--text-light);
    opacity: 0.75;
  }

  .acts-section {
    margin-bottom: 30px;
    padding: 25px;
    background: rgba(0, 255, 255, 0.06);
    border: 2px solid var(--retro-cyan);
    border-radius: 8px;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.25);
  }

  .acts-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .act-chip {
    display: inline-block;
    padding: 8px 16px;
    background: linear-gradient(135deg, var(--bg-medium) 0%, var(--bg-dark) 100%);
    color: var(--text-light);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 16px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .act-chip:hover {
    border-color: var(--retro-cyan);
    box-shadow: 0 0 12px rgba(0, 255, 255, 0.4);
  }

  .labels-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .label-tag {
    display: inline-block;
    padding: 6px 16px;
    background: linear-gradient(135deg, var(--retro-purple) 0%, var(--retro-pink) 100%);
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 16px;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.3), 0 0 12px rgba(255, 110, 199, 0.4);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.3);
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .label-tag.label-red {
    background: linear-gradient(135deg, #ff1744 0%, #ff5252 100%);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.3), 0 0 15px rgba(255, 23, 68, 0.6);
  }

  .label-tag.label-blue {
    background: linear-gradient(135deg, #2979ff 0%, #448aff 100%);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.3), 0 0 15px rgba(41, 121, 255, 0.6);
  }

  .actions-section {
    margin-bottom: 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  .calendar-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .tbd-notice {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    margin-bottom: 16px;
    background: rgba(255, 214, 10, 0.08);
    border: 1px dashed rgba(255, 214, 10, 0.5);
    border-radius: 8px;
    color: var(--retro-yellow);
    font-size: 1rem;
    font-weight: 600;
  }

  .share-buttons-wrapper {
    display: flex;
    justify-content: center;
  }

  .calendar-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    min-height: 48px;
    background: linear-gradient(135deg, var(--retro-cyan) 0%, var(--retro-purple) 100%);
    color: white;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: 30px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.3),
      0 0 20px rgba(0, 255, 255, 0.5);
    transition: all 0.3s ease;
  }

  .calendar-button:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 0 rgba(0, 0, 0, 0.3),
      0 0 30px rgba(0, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .calendar-button:active {
    transform: translateY(0);
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.3),
      0 0 20px rgba(0, 255, 255, 0.5);
  }

  .event-content {
    margin-bottom: 30px;
  }

  .content-text {
    font-family: var(--font-base);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-light);
    margin: 0;
    padding: 20px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    border: 2px solid rgba(255, 110, 199, 0.3);
    word-wrap: break-word;
  }

  .content-link {
    color: var(--retro-cyan);
    text-decoration: underline;
    word-break: break-all;
  }

  .event-images {
    margin-bottom: 40px;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .event-image {
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: contain;
    border-radius: 8px;
    border: 3px solid var(--retro-cyan);
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.5);
    transition: all 0.3s ease;
  }

  .event-image:hover {
    transform: scale(1.02);
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.8);
  }

  .back-link-wrapper {
    margin-top: 40px;
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background: linear-gradient(135deg, var(--retro-purple) 0%, var(--retro-pink) 100%);
    color: white;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 25px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    box-shadow:
      0 4px 0 rgba(0, 0, 0, 0.3),
      0 0 15px rgba(255, 110, 199, 0.4);
    transition: all 0.3s ease;
  }

  .back-link:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 0 rgba(0, 0, 0, 0.3),
      0 0 25px rgba(255, 110, 199, 0.6);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .back-link:active {
    transform: translateY(0);
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.3),
      0 0 15px rgba(255, 110, 199, 0.4);
  }

  /* レスポンシブ対応 */
  @media (max-width: 768px) {
    .event-detail {
      padding: 30px 16px;
    }

    .event-header {
      padding: 25px 20px;
    }

    .event-title {
      font-size: 2rem;
    }

    .event-date {
      font-size: 1rem;
    }

    .section-title {
      font-size: 1.3rem;
    }

    .venue-section {
      padding: 20px;
    }

    .venue-name {
      font-size: 1.1rem;
    }

    .content-text {
      font-size: 0.9rem;
      padding: 16px;
    }

    .calendar-button {
      font-size: 1rem;
      padding: 12px 24px;
      min-height: 44px;
    }

    .image-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .event-detail {
      padding: 20px 12px;
    }

    .event-header {
      padding: 20px 16px;
    }

    .event-title {
      font-size: 1.6rem;
    }

    .event-date {
      font-size: 0.9rem;
    }

    .section-title {
      font-size: 1.2rem;
    }

    .venue-section {
      padding: 16px;
    }

    .venue-name {
      font-size: 1rem;
    }

    .content-text {
      font-size: 0.85rem;
      padding: 14px;
    }

    .calendar-button {
      font-size: 0.95rem;
      padding: 12px 20px;
      min-height: 42px;
      width: 100%;
    }
  }

  /* アニメーション無効化（アクセシビリティ） */
  @media (prefers-reduced-motion: reduce) {
