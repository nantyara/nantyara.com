---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';

interface HistoryEntry {
  date: string; // YYYY | YYYY-MM | YYYY-MM-DD
  title: string;
  description?: string;
  category: string;
  approx?: boolean;
  link?: string;
  image?: string;
}

// 手動マイルストーン
const historyYaml = readFileSync('src/data/history.yml', 'utf-8');
const manualEntries: HistoryEntry[] = (parse(historyYaml) ?? []).map((e: any) => ({
  category: 'milestone',
  ...e,
  date: String(e.date),
}));

// リリース情報を自動マージ
const releasesYaml = readFileSync('src/data/releases.yml', 'utf-8');
const releases = parse(releasesYaml) ?? [];
const typeLabels: Record<string, string> = { album: 'アルバム', single: 'シングル', ep: 'EP' };
const releaseEntries: HistoryEntry[] = releases.map((r: any) => ({
  date: String(r.release_date),
  title: `「${r.title}」リリース`,
  description: [typeLabels[r.type] ?? r.type, r.format, r.label].filter(Boolean).join(' / '),
  category: 'release',
  link: `/releases/${r.id}`,
  image: r.jacket_image,
}));

// 日付キーでソート（YYYY / YYYY-MM / YYYY-MM-DD 混在に対応するため文字列比較）
const sortKey = (d: string) => d.padEnd(10, '0');
const entries = [...manualEntries, ...releaseEntries].sort((a, b) =>
  sortKey(a.date).localeCompare(sortKey(b.date))
);

// 年ごとにグルーピング（古い順）
const yearGroups: { year: string; items: HistoryEntry[] }[] = [];
for (const entry of entries) {
  const year = entry.date.slice(0, 4);
  let group = yearGroups.find(g => g.year === year);
  if (!group) {
    group = { year, items: [] };
    yearGroups.push(group);
  }
  group.items.push(entry);
}

// 日付の表示（精度に応じて年 / 年月 / 年月日）
const formatEntryDate = (entry: HistoryEntry) => {
  const parts = entry.date.split('-');
  let text = '';
  if (parts.length === 1) text = `${Number(parts[0])}年`;
  else if (parts.length === 2) text = `${Number(parts[1])}月`;
  else text = `${Number(parts[1])}月${Number(parts[2])}日`;
  return entry.approx ? `${text}頃` : text;
};

const categoryInfo: Record<string, { icon: string; label: string }> = {
  milestone: { icon: 'fa-solid fa-star', label: 'マイルストーン' },
  live: { icon: 'fa-solid fa-microphone', label: 'ライブ' },
  radio: { icon: 'fa-solid fa-podcast', label: 'ラジオ' },
  release: { icon: 'fa-solid fa-compact-disc', label: 'リリース' },
  media: { icon: 'fa-solid fa-tv', label: 'メディア' },
};
---

<Layout
  title="沿革 | なんちゃらアイドル"
  description="なんちゃらアイドルのこれまでのあゆみ"
>
  <div class="history-container">
    <div class="timeline">
      {yearGroups.map(group => (
        <section class="timeline-year">
          <h2 class="year-marker"><span>{group.year}</span></h2>
          <div class="year-entries">
            {group.items.map(entry => {
              const cat = categoryInfo[entry.category] ?? categoryInfo.milestone;
              return (
                <article class={`timeline-entry cat-${entry.category}`}>
                  <div class="entry-icon">
                    <i class={cat.icon} aria-hidden="true" title={cat.label}></i>
                  </div>
                  <div class="entry-card">
                    <div class="entry-date">{formatEntryDate(entry)}</div>
                    <h3 class="entry-title">
                      {entry.link ? <a href={entry.link}>{entry.title}</a> : entry.title}
                    </h3>
                    {entry.description && <p class="entry-description">{entry.description}</p>}
                  </div>
                  {entry.image && (
                    <a href={entry.link} class="entry-thumb">
                      <img src={entry.image} alt={entry.title} loading="lazy" />
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .history-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .timeline {
    position: relative;
    padding-left: 28px;
  }

  /* 縦のタイムライン */
  .timeline::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      180deg,
      var(--retro-pink) 0%,
      var(--retro-purple) 50%,
      var(--retro-cyan) 100%
    );
    box-shadow: 0 0 10px rgba(255, 110, 199, 0.4);
    border-radius: 2px;
  }

  .timeline-year {
    margin-bottom: 40px;
  }

  .year-marker {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 0 0 20px -28px;
    padding: 12px 0 12px 28px;
    font-family: var(--font-digital);
    font-size: 1.6rem;
    letter-spacing: 3px;
    color: var(--retro-yellow);
    text-shadow: 0 0 12px rgba(255, 214, 10, 0.5);
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .year-entries {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .timeline-entry {
    position: relative;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .entry-icon {
    position: absolute;
    left: -28px;
    top: 14px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-dark);
    border: 2px solid var(--retro-pink);
    border-radius: 50%;
    font-size: 0.6rem;
    color: var(--retro-pink);
    box-shadow: 0 0 8px rgba(255, 110, 199, 0.6);
  }

  .cat-release .entry-icon {
    border-color: var(--retro-yellow);
    color: var(--retro-yellow);
    box-shadow: 0 0 8px rgba(255, 214, 10, 0.6);
  }

  .cat-radio .entry-icon {
    border-color: var(--retro-purple);
    color: var(--retro-purple);
    box-shadow: 0 0 8px rgba(157, 78, 221, 0.6);
  }

  .cat-live .entry-icon {
    border-color: var(--retro-cyan);
    color: var(--retro-cyan);
    box-shadow: 0 0 8px rgba(0, 255, 255, 0.6);
  }

  .entry-card {
    flex: 1;
    padding: 16px 20px;
    background: linear-gradient(135deg, var(--bg-medium) 0%, var(--bg-dark) 100%);
    border: 1px solid rgba(255, 110, 199, 0.3);
    border-radius: 8px;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.3);
  }

  .entry-date {
    font-family: var(--font-digital);
    font-size: 0.85rem;
    color: var(--pastel-lavender);
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .entry-title {
    font-size: 1.1rem;
    margin: 0 0 6px;
    line-height: 1.5;
  }

  .entry-title a {
    color: var(--retro-cyan);
    text-decoration: none;
  }

  .entry-title a:hover {
    text-decoration: underline;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.5);
  }

  .entry-description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-light);
    opacity: 0.85;
    line-height: 1.7;
  }

  .entry-thumb {
    flex-shrink: 0;
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid var(--retro-purple);
    box-shadow: 0 0 10px rgba(157, 78, 221, 0.4);
  }

  .entry-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 480px) {
    .history-container {
      padding: 0 12px;
    }

    .entry-card {
      padding: 12px 14px;
    }

    .entry-title {
      font-size: 1rem;
    }

    .entry-thumb {
      width: 56px;
      height: 56px;
    }
  }
</style>
