      "url": "https://x.com/nantyaraidol/status/1848319969744031923",
      "time": "2024-10-21T11:06:35.000Z",
      "handle": "@nantyaraidol",
      "text": "オールディックフォギーと対バン、羨ましすぎてあたまおかしくなりそう！",
