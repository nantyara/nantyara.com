      "isReply": false
    },
    {
      "url": "https://x.com/samami27/status/1850361052900507823",
      "time": "2024-10-27T02:17:07.000Z",
      "handle": "@samami27",
      "text": "今日会う人にはすべからくライブについて話す。（多分）",
