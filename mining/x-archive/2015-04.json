      "text": "チェキ帳こうなった！",
      "imgs": [],
      "isReply": false
    },
    {
      "url": "/samami27/status/592305664308850689",
      "time": "2015-04-26T12:34:09.000Z",
      "handle": "@samami27",
      "text": "iPodはこうなった！",
      "imgs": [],
      "isReply": false
    },
    {
      "url": "/samami27/status/592564047536500736",
      "time": "2015-04-27T05:40:52.000Z",
      "handle": "@samami27",
      "text": "元気もりもり！緊張ごりごり！うひゃー！",
      "imgs": [],
